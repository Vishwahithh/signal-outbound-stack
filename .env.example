# Copy to .env and fill in your own keys. .env is git-ignored; never commit it.
# treg: one token for the catalog providers (company search, people discovery, LinkedIn profiles, email finders, jobs)
TREG_TOKEN=
# Deepline needs no key here: run `deepline setup` once (browser login)
MILLIONVERIFIER_API_KEY=
ATTIO_API_KEY=
# Optional paid fallbacks for sites the free crawler cannot read
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
EXA_API_KEY=
# Person research (scripts/person_research.py) and the Apify backend of clean_people.py verify; comma-separated
APIFY_TOKENS=
# Optional: dated company events for person_research.py --explorium-events
EXPLORIUM_API_KEY=
